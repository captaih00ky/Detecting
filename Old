  <button class="active" data-tab="tab-map">
    <svg class="tabicon" viewBox="0 0 24 24"><path d="M3 7l6-2.5 6 2.5 6-2.5V17l-6 2.5-6-2.5-6 2.5z"/><path d="M9 4.5V17M15 7v12.5"/></svg>
    Map
