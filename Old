document.getElementById('btnTrackToggle').addEventListener('click', ()=>{
  if(!tracking){
    if(!navigator.geolocation){ alert('Geolocation not available on this device/browser.'); return; }
    watchId = navigator.geolocation.watchPosition(p=>{
      track.push({lat:p.coords.latitude, lon:p.coords.longitude, t:Date.now(), signal:null});
      save('md_track', track);
      updateTrackStatus();
      refreshMapView();
    }, e=>{ console.warn(e); }, {enableHighAccuracy:true, maximumAge:2000, timeout:10000});
    tracking = true;
    document.getElementById('btnTrackToggle').textContent = 'Stop walking';
  } else {
    navigator.geolocation.clearWatch(watchId);
    tracking = false;
    document.getElementById('btnTrackToggle').textContent = 'Start walking';
