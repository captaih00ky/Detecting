function signalColor(s){
  if(s===null || s===undefined) return '#556677';
  if(s<30) return '#4C8BF5';
  if(s<60) return '#6E8F72';
  if(s<85) return '#D9A35E';
  return '#C0392B';
}

function drawMap(){
 try{
  const canvas = document.getElementById('mapCanvas');
  const ctx = canvas.getContext('2d');
  if(!ctx) return;
  const w = canvas.clientWidth || 320;
  canvas.width = w; canvas.height = 260;
  ctx.clearRect(0,0,canvas.width,canvas.height);
  if(track.length<1){
    ctx.fillStyle='#665f4f'; ctx.font='13px sans-serif';
    ctx.fillText('No points yet — tap "Start walking" or "Log reading here".', 14, 30);
    return;
  }
  const lat0 = track[0].lat, lon0 = track[0].lon;
  const mPerDegLat = 111320;
  const mPerDegLon = 111320*Math.cos(lat0*Math.PI/180);
  const pts = track.map(p=>({
    x:(p.lon-lon0)*mPerDegLon,
    y:(p.lat-lat0)*mPerDegLat,
    signal:p.signal
  }));
  const xs=pts.map(p=>p.x), ys=pts.map(p=>p.y);
  const minX=Math.min(...xs), maxX=Math.max(...xs), minY=Math.min(...ys), maxY=Math.max(...ys);
  const pad=24;
  const spanX=Math.max(maxX-minX,1), spanY=Math.max(maxY-minY,1);
  const scale = Math.min((canvas.width-2*pad)/spanX, (canvas.height-2*pad)/spanY);
  function toCanvas(p){
    return {
      cx: pad + (p.x-minX)*scale,
      cy: canvas.height - pad - (p.y-minY)*scale
    };
  }
  ctx.strokeStyle='#556677'; ctx.lineWidth=2; ctx.beginPath();
  pts.forEach((p,i)=>{ const c=toCanvas(p); if(i===0) ctx.moveTo(c.cx,c.cy); else ctx.lineTo(c.cx,c.cy); });
  ctx.stroke();
  pts.forEach(p=>{
    if(p.signal===null || p.signal===undefined) return;
    const c=toCanvas(p);
    ctx.fillStyle=signalColor(p.signal);
    ctx.beginPath(); ctx.arc(c.cx,c.cy,5,0,7); ctx.fill();
  });
  // start/current markers
  const start = toCanvas(pts[0]);
  ctx.fillStyle='#EDE6D3'; ctx.beginPath(); ctx.arc(start.cx,start.cy,3,0,7); ctx.fill();
 }catch(e){ console.error('drawMap failed:', e); }
}
drawMap();

