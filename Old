  finds.unshift({
    id: Date.now(),
    name,
    vdi: document.getElementById('findVDI').value,
    depth: document.getElementById('findDepth').value,
    notes: document.getElementById('findNotes').value,
    loc: pendingLoc,
    date: new Date().toISOString()
  });
  save('md_finds', finds);
