<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Field Companion — XP Deus 2</title>
<style>
:root{
  --ground:#171310;
  --panel:#211B14;
  --panel-2:#2A2318;
  --brass:#C08A42;
  --brass-deep:#8C5F27;
  --brass-bright:#E0AD68;
  --verdigris:#7A9683;
  --rust:#A5543D;
  --bone:#EDE3CE;
  --bone-dim:#9C9078;
  --hairline:#38301F;
  --hairline-soft:rgba(237,227,206,0.06);
  --font-head: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
  --font-body: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-mono: 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;background:var(--ground);color:var(--bone);font-family:var(--font-body);}
body{
  padding-bottom:70px;
  background-image:
    radial-gradient(ellipse 900px 500px at 15% -10%, rgba(192,138,66,0.05), transparent 60%),
    radial-gradient(ellipse 700px 500px at 100% 0%, rgba(122,150,131,0.04), transparent 55%);
  background-attachment:fixed;
}
h1,h2,h3{font-family:var(--font-head); font-weight:600; color:var(--brass-bright); margin:0 0 8px; letter-spacing:0.1px;}
h1{font-size:21px; font-weight:700;}
h2{font-size:17px; margin-top:2px;}
h3{font-size:14.5px; color:var(--bone); margin-bottom:6px;}
p{line-height:1.55; color:var(--bone-dim); font-size:14px;}
.panel{display:none; padding:14px 16px 34px;}
.panel.active{display:block; animation:rise 0.22s ease-out;}
@keyframes rise{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:translateY(0);}}
.card{
  background:linear-gradient(var(--panel), var(--panel));
  background-color:var(--panel);
  border:1px solid var(--hairline);
  border-radius:5px;
  padding:15px 16px;
  margin-bottom:12px;
  box-shadow: inset 0 1px 0 var(--hairline-soft);
  position:relative;
}
.card::before{
  content:''; position:absolute; left:0; top:0; bottom:0; width:2px;
  background:linear-gradient(var(--brass-deep), transparent 85%);
  border-radius:5px 0 0 5px;
  opacity:0.55;
}
.row{display:flex; gap:8px; flex-wrap:wrap;}
.row > *{flex:1;}
button{
  background:var(--panel-2); color:var(--bone); border:1px solid var(--hairline);
  border-radius:4px; padding:10px 12px; font-size:13.5px; font-family:var(--font-body); font-weight:600;
  letter-spacing:0.1px; transition:transform 0.08s ease, background 0.15s ease;
}
button.primary{
  background:linear-gradient(180deg, var(--brass-bright), var(--brass) 65%, var(--brass-deep));
  color:#211405; border-color:var(--brass-deep); font-weight:700;
}
button.danger{border-color:var(--rust); color:var(--rust); background:transparent;}
button:active{transform:scale(0.97); opacity:0.9;}
input, textarea, select{
  background:#151009; border:1px solid var(--hairline); color:var(--bone); border-radius:4px;
  padding:9px 10px; font-size:14px; font-family:var(--font-body); width:100%; margin-bottom:8px;
}
input:focus, textarea:focus, select:focus{outline:none; border-color:var(--brass);}
label{font-size:11.5px; color:var(--bone-dim); display:block; margin-bottom:3px; letter-spacing:0.15px;}
.readout{font-family:var(--font-mono); color:var(--brass-bright); font-size:13.5px; letter-spacing:0.2px;}
table{width:100%; border-collapse:collapse; font-size:13px;}
th,td{text-align:left; padding:8px 6px; border-bottom:1px solid var(--hairline); vertical-align:top;}
th{
  color:var(--bone-dim); font-weight:600; font-size:11.5px; letter-spacing:0.2px;
  position:sticky; top:0; background:var(--panel); border-bottom:1px solid var(--brass-deep);
}
tbody tr:nth-child(even){background:rgba(237,227,206,0.02);}
.tier-ferrous{color:var(--rust);}
.tier-low{color:#9C8A5A;}
.tier-med{color:var(--verdigris);}
.tier-high{color:var(--brass-bright);}
.pill{display:inline-block; padding:2px 9px; border-radius:999px; font-size:10.5px; border:1px solid currentColor; letter-spacing:0.2px;}
.finditem{border-bottom:1px solid var(--hairline); padding:11px 0;}
.finditem:last-child{border-bottom:none;}
.small{font-size:12px; color:var(--bone-dim);}
.header{
  padding:20px 18px 14px; border-bottom:1px solid var(--hairline);
  display:flex; align-items:center; gap:12px;
  background:linear-gradient(180deg, rgba(192,138,66,0.05), transparent);
}
.emblem{flex:none; width:34px; height:34px; color:var(--brass); opacity:0.9;}
.header-text h1{font-variant:small-caps; font-size:23px; letter-spacing:0.5px;}
.header-text p{margin:0; font-size:12.5px;}
.tabbar{
  position:fixed; bottom:0; left:0; right:0; display:flex;
  background:linear-gradient(180deg, var(--panel), #1B160F);
  border-top:1px solid var(--hairline); z-index:10;
  box-shadow: 0 -6px 16px rgba(0,0,0,0.25);
}
.tabbar button{
  flex:1; background:none; border:none; border-radius:0; color:var(--bone-dim);
  font-size:10px; padding:9px 2px 10px; font-weight:600; letter-spacing:0.1px;
  display:flex; flex-direction:column; align-items:center; gap:3px;
}
.tabbar button.active{color:var(--brass-bright);}
.tabbar button.active svg{stroke:var(--brass-bright);}
.tabicon{width:19px; height:19px; stroke:var(--bone-dim); fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round;}
canvas{width:100%; background:#12100B; border-radius:5px; border:1px solid var(--hairline); touch-action:none;}
hr{border:none; border-top:1px solid var(--hairline); margin:14px 0;}
.searchbox{position:sticky; top:0; z-index:2;}
.legend{display:flex; gap:10px; flex-wrap:wrap; font-size:11px; color:var(--bone-dim); margin-top:6px;}
.dot{display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; vertical-align:middle;}
a{color:var(--verdigris);}
.note{font-size:12px; color:var(--bone-dim); border-left:2px solid var(--brass); padding-left:10px; margin:10px 0;}
</style>
</head>
