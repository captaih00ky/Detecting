["Roman brooch (fibula)","1st–4th c AD","Bronze/copper alloy","med","Bow-shaped or penannular (open ring) form; look for a corroded pin or catch-plate on the back even if the pin itself is gone"],
["Medieval strap end / belt mount","11th–15th c","Bronze, occasionally silver","med-high","Small, tongue-shaped fitting from the end of a belt or strap; sometimes gilded or decorated"],
["Seal matrix","medieval–post-medieval","Bronze, lead, or occasionally silver","med-high","Engraved, mirror-image design or initials made to stamp wax; a genuinely exciting find if a name is legible"],
["Lead cloth/bag seal","14th–19th c","Lead","ferrous-low","Two flattened discs joined by a strip, stamped with a merchant's or town's mark; scattered along old market and trade routes"],
["Horse harness/tack fitting","Roman–Victorian","Bronze/copper alloy","med","Decorative strap junctions, pendants and buckles from tack; heavily represented on any site with centuries of horse traffic"],
["Lead toy figure (soldier/animal)","19th–20th c","Lead-tin alloy","ferrous-low","Same low-conductivity issue as musket balls — check your discrimination isn't quietly rejecting this whole category"],
["Clay tobacco pipe (stem/bowl)","17th–19th c","Fired clay — not metal","none","Won't trigger a detector, but you'll dig plenty alongside metal finds; rough rule of thumb — the wider the stem bore, the earlier the pipe"],
["Hammered coin (general)","pre-1662 in England","Silver, mostly","high","Irregular, slightly uneven round shape, off-centre design, no milled/reeded edge, and thinner than a modern coin of similar size — struck by hand between two dies"],
];
const otherTierClass = {ferrous:'tier-ferrous','ferrous-low':'tier-ferrous', low:'tier-low', med:'tier-med', 'med-high':'tier-high', high:'tier-high', none:''};
const otherTierLabel = {'ferrous-low':'Low / ferrous-ish', low:'Low', med:'Medium', 'med-high':'Med–High', high:'High', none:'—'};
function renderOther(filter){
  const body = document.getElementById('otherBody');
  const f = (filter||'').toLowerCase();
  body.innerHTML = otherFinds
    .filter(r=>!f || r.slice(0,3).join(' ').toLowerCase().includes(f))
    .map(r=>`<tr>
      <td><strong>${r[0]}</strong></td>
      <td>${r[1]}</td>
      <td>${r[2]}</td>
      <td><span class="pill ${otherTierClass[r[3]]||''}">${otherTierLabel[r[3]]||r[3]}</span></td>
      <td class="small">${r[4]}</td>
    </tr>`).join('');
}
renderOther('');
document.getElementById('otherSearch').addEventListener('input', e=>renderOther(e.target.value));
</script>
