/* ---------- storage helpers ---------- */
function load(key, fallback){ try{ const v=localStorage.getItem(key); return v?JSON.parse(v):fallback; }catch(e){ return fallback; } }
function save(key, val){ try{ localStorage.setItem(key, JSON.stringify(val)); }catch(e){} }

/* ---------- JSON backup / restore ---------- */
const BACKUP_KEYS = ['md_track','md_finds','md_vdilog'];
function setupBackupUI(){
  try{
    const exportBtn = document.getElementById('backupExportBtn');
    const importBtn = document.getElementById('backupImportBtn');
    const fileInput = document.getElementById('backupFileInput');
    const status = document.getElementById('backupStatus');
    if(!exportBtn || !importBtn || !fileInput) return;

    exportBtn.addEventListener('click', ()=>{
      try{
        const payload = { app:'detecting_companion', exportedAt: new Date().toISOString(), data:{} };
        BACKUP_KEYS.forEach(k=>{ payload.data[k] = load(k, []); });
        const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
        const a = document.createElement('a');
        const stamp = new Date().toISOString().slice(0,10);
        a.href = URL.createObjectURL(blob);
        a.download = 'detecting-backup-' + stamp + '.json';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        if(status) status.textContent = 'Backup file downloaded.';
      }catch(e){ if(status) status.textContent = 'Export failed: ' + e.message; }
    });

    importBtn.addEventListener('click', ()=>{ fileInput.click(); });

    fileInput.addEventListener('change', (ev)=>{
      const file = ev.target.files && ev.target.files[0];
      if(!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try{
          const parsed = JSON.parse(reader.result);
          const data = parsed && parsed.data ? parsed.data : parsed; // tolerate raw key/value too
          if(!data || typeof data !== 'object') throw new Error('File does not look like a valid backup.');
          if(!confirm('Restore this backup? This replaces your current track, finds, and VDI log.')) { fileInput.value=''; return; }
          BACKUP_KEYS.forEach(k=>{
            if(Object.prototype.hasOwnProperty.call(data, k)) save(k, data[k]);
          });
          if(status) status.textContent = 'Backup restored. Reloading…';
          setTimeout(()=>location.reload(), 600);
        }catch(e){
          if(status) status.textContent = 'Restore failed: ' + e.message;
        }
        fileInput.value = '';
      };
      reader.onerror = () => { if(status) status.textContent = 'Could not read that file.'; fileInput.value=''; };
      reader.readAsText(file);
    });
  }catch(e){ /* backup UI is non-critical, never block the app */ }
}
setupBackupUI();

/* ---------- CSV export ---------- */
function downloadCSV(filename, rows){
  const csv = rows.map(r=>r.map(c=>'"'+String(c===undefined?'':c).replace(/"/g,'""')+'"').join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
}

/* ---------- geolocation ---------- */
function getPos(){
  return new Promise((res,rej)=>{
    if(!navigator.geolocation){ rej('no geolocation'); return; }
    navigator.geolocation.getCurrentPosition(p=>res(p.coords), e=>rej(e.message), {enableHighAccuracy:true, timeout:8000});
  });
}

/* ================= FIELD MAP ================= */
let track = load('md_track', []);
let watchId = null;
let tracking = false;
let mapMode = 'sketch'; // 'sketch' (offline canvas) or 'live' (real map, needs signal)
let leafletMap = null, leafletMarker = null, leafletPath = null, leafletPoints = null;
let lidarLayer = null;

function toggleLidar(on){
  if(!leafletMap) return;
  if(on){
    if(!lidarLayer){
      lidarLayer = L.tileLayer.wms('https://environment.data.gov.uk/geoservices/datasets/09ea3b37-df3a-4e8b-ac69-fb0842227b04/wms', {
        layers: 'Lidar_Composite_Hillshade_DTM_2m',
        format: 'image/png',
        transparent: true,
        opacity: 0.65,
        attribution: 'Contains Environment Agency LIDAR data &copy; Environment Agency'
      });
    }
    lidarLayer.addTo(leafletMap);
  } else if(lidarLayer){
    leafletMap.removeLayer(lidarLayer);
  }
}

function loadLeaflet(){
  return new Promise((resolve, reject)=>{
    if(window.L){ resolve(); return; }
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
    document.head.appendChild(link);
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.onload = ()=>resolve();
    script.onerror = ()=>reject(new Error('no signal'));
    document.head.appendChild(script);
  });
}

function initOrUpdateLeaflet(){
  if(!window.L) return;
  const latlngs = track.map(p=>[p.lat, p.lon]);
  if(!leafletMap){
    const start = latlngs.length ? latlngs[latlngs.length-1] : [51.5074, -0.1278];
    leafletMap = L.map('leafletMap').setView(start, 17);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19, attribution: '&copy; OpenStreetMap contributors'
    }).addTo(leafletMap);
    leafletPath = L.polyline([], {color:'#B9843F', weight:3}).addTo(leafletMap);
    leafletMarker = L.marker(start).addTo(leafletMap);
    leafletPoints = L.layerGroup().addTo(leafletMap);
  }
  leafletPath.setLatLngs(latlngs);
  leafletPoints.clearLayers();
  track.forEach(p=>{
    if(p.signal!==null && p.signal!==undefined){
      L.circleMarker([p.lat,p.lon], {radius:6, color:signalColor(p.signal), fillColor:signalColor(p.signal), fillOpacity:0.9, weight:1})
        .addTo(leafletPoints);
    }
  });
  if(latlngs.length){
    const last = latlngs[latlngs.length-1];
    leafletMarker.setLatLng(last);
    leafletMap.panTo(last);
  }
  setTimeout(()=>{ if(leafletMap) leafletMap.invalidateSize(); }, 150);
  toggleLidar(document.getElementById('chkLidar').checked);
}

function refreshMapView(){
  if(mapMode==='live') initOrUpdateLeaflet(); else drawMap();
}

document.getElementById('btnMapMode').addEventListener('click', async ()=>{
  const btn = document.getElementById('btnMapMode');
  if(mapMode==='sketch'){
    btn.textContent = 'Loading map…';
    try{
      await loadLeaflet();
      document.getElementById('mapCanvas').style.display = 'none';
      document.getElementById('leafletMap').style.display = 'block';
      mapMode = 'live';
      btn.textContent = 'Switch to offline sketch';
      initOrUpdateLeaflet();
    }catch(e){
      alert('Could not load the live map — this needs a data or wifi signal. Staying on the offline sketch.');
      btn.textContent = 'Switch to live map';
    }
  } else {
    document.getElementById('leafletMap').style.display = 'none';
    document.getElementById('mapCanvas').style.display = 'block';
    mapMode = 'sketch';
    btn.textContent = 'Switch to live map';
    drawMap();
  }
});

document.getElementById('chkLidar').addEventListener('change', e=>{
  if(mapMode!=='live'){
    alert('Switch to live map first — the LIDAR layer streams from a national dataset and needs a signal, same as the street map.');
    e.target.checked = false;
    return;
  }
  toggleLidar(e.target.checked);
});

function updateTrackStatus(){
  document.getElementById('trackStatus').textContent =
