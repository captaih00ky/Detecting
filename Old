function renderFinds(){
  const el = document.getElementById('findList');
  if(finds.length===0){ el.innerHTML='<p class="small">No finds logged yet.</p>'; return; }
  el.innerHTML = finds.map(f=>`
    <div class="finditem">
      <strong>${escapeHtml(f.name)}</strong>
      <div class="small">${new Date(f.date).toLocaleDateString()} ${f.vdi?(' · VDI '+f.vdi):''}${f.depth?(' · '+f.depth+'cm deep'):''}</div>
      ${f.notes?('<div class="small">'+escapeHtml(f.notes)+'</div>'):''}
      ${f.loc?('<div class="small readout">'+f.loc.lat.toFixed(5)+', '+f.loc.lon.toFixed(5)+'</div>'):''}
      <button class="danger" style="margin-top:6px;" onclick="deleteFind(${f.id})">Delete</button>
    </div>`).join('');
}
function deleteFind(id){
  finds = finds.filter(f=>f.id!==id);
  save('md_finds', finds);
  renderFinds();
}
function escapeHtml(s){ const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

document.getElementById('btnExportFinds').addEventListener('click', ()=>{
  const rows=[['date','name','vdi','depth_cm','notes','lat','lon']];
  finds.forEach(f=>rows.push([f.date, f.name, f.vdi, f.depth, f.notes, f.loc?f.loc.lat:'', f.loc?f.loc.lon:'']));
